// Prisma schema for Appointment Booking System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  email     String    @unique
  password  String
  firstName String?
  lastName  String?
  role      Role      @default(USER)
  company   String?
  mobile    String?
  address   String?
  bio       String?
  position  String?
  website   String?
  timezone  String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  services             Service[]
  appointmentsAsUser   Appointment[] @relation("UserAppointments")
  appointmentsAsClient Appointment[] @relation("ClientAppointments")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    String   @default("1 hour")
  category    String?
  isActive    Boolean  @default(true)
  rating      Float?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  clientId  String?
  date      DateTime
  time      String
  duration  String
  amount    Float
  status    Status   @default(PENDING)
  notes     String?
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation("UserAppointments", fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  client  User?   @relation("ClientAppointments", fields: [clientId], references: [id])
}

enum Role {
  USER
  CLIENT
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
