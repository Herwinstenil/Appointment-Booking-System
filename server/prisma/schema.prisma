// Prisma schema for Appointment Booking System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  firstName String?
  lastName  String?
  role      Role     @default(USER)
  status    UserStatus @default(ACTIVE)
  company   String?
  mobile    String?
  address   String?
  bio       String?
  position  String?
  website   String?
  timezone  String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientNo  Int?     @default(0)
  revenue   Float?   @default(0.0)

  // Social login IDs
  googleId    String? @unique
  facebookId  String? @unique
  twitterId   String? @unique
  githubId    String? @unique
  instagramId String? @unique

  // Relations
  services               Service[]
  appointmentsAsUser     Appointment[] @relation("UserAppointments")
  appointmentsAsClient   Appointment[] @relation("ClientAppointments")
  activities             Activity[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    String   @default("1 hour")
  category    String?
  isActive    Boolean  @default(true)
  rating      Float?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  clientId  String?
  date      DateTime
  time      String
  duration  String
  amount    Float
  status    Status   @default(PENDING)
  notes     String?
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation("UserAppointments", fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  client  User?   @relation("ClientAppointments", fields: [clientId], references: [id])
}

enum Role {
  USER
  CLIENT
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum ActivityType {
  ADMIN_LOGIN
  ADMIN_CREATED
  CLIENT_CREATED
  REPORT_GENERATED
}

model Activity {
  id          String      @id @default(cuid())
  type        ActivityType
  description String
  userId      String?     // admin who performed the action
  targetId    String?     // id of the target (new admin, new client, etc.)
  metadata    Json?       // additional data
  createdAt   DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id])
}
