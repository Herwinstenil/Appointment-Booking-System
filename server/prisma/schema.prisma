generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id @default(cuid())
  username              String        @unique
  email                 String?       @unique
  password              String?
  firstName             String?
  lastName              String?
  role                  Role          @default(USER)
  company               String?
  mobile                String?
  address               String?
  bio                   String?
  position              String?
  website               String?
  isActive              Boolean       @default(true)
  lastLogin             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  clientNo              Int?          @unique
  revenue               Float?        @default(0.0)
  googleId              String?       @unique
  facebookId            String?       @unique
  githubId              String?       @unique
  avatarUrl             String?
  emailVerified         Boolean       @default(false)
  twoFactorEnabled      Boolean       @default(false)
  passwordUpdatedAt     DateTime?
  lastSuspiciousLoginAt DateTime?
  language              String        @default("en")
  twoFactorSecret       String?
  twoFactorTempSecret   String?
  twoFactorMethod       String?       @default("APP")
  twoFactorOtpCodeHash  String?
  activities            Activity[]
  appointmentsAsClient  Appointment[] @relation("ClientAppointments")
  appointmentsAsUser    Appointment[] @relation("UserAppointments")
  uploads               FileUpload[]
  services              Service[]     @relation("ClientServices")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Float
  category     String?
  isActive     Boolean       @default(true)
  rating       Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clientNo     Int
  appointments Appointment[]
  client       User          @relation("ClientServices", fields: [clientNo], references: [clientNo])
}

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  date      DateTime
  time      String
  amount    Float
  status    Status   @default(PENDING)
  notes     String?
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientNo  Int
  client    User     @relation("ClientAppointments", fields: [clientNo], references: [clientNo])
  service   Service  @relation(fields: [serviceId], references: [id])
  user      User     @relation("UserAppointments", fields: [userId], references: [id])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  userId      String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id])
}

model FileUpload {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  mimeType    String?
  sizeInBytes BigInt   @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model ClientAvailability {
  clientNo     Int      @id
  availability Json
  timeSlots    Json
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
}

enum Role {
  USER
  CLIENT
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  ADMIN_LOGIN
  ADMIN_CREATED
  CLIENT_CREATED
  CLIENT_DELETED
  CLIENT_EDITED
  REPORT_GENERATED
  REPORT_DOWNLOADED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
}
