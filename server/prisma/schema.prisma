// Prisma schema for Appointment Booking System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  firstName String?
  lastName  String?
  role      Role     @default(USER)
  company   String?
  mobile    String?
  address   String?
  bio       String?
  avatarUrl String?
  language  String   @default("en")
  emailVerified      Boolean  @default(false)
  twoFactorEnabled   Boolean  @default(false)
  passwordUpdatedAt  DateTime?
  lastSuspiciousLoginAt DateTime?
  position  String?
  website   String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientNo  Int?     @unique
  revenue   Float?   @default(0.0)

  // Social login IDs
  googleId    String? @unique
  facebookId  String? @unique
  githubId    String? @unique
  instagramId String? @unique

  // Relations
  services               Service[] @relation("ClientServices")
  appointmentsAsUser     Appointment[] @relation("UserAppointments")
  appointmentsAsClient   Appointment[] @relation("ClientAppointments")
  activities             Activity[]
  uploads                FileUpload[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  category    String?
  isActive    Boolean  @default(true)
  rating      Float?
  clientNo    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      User        @relation("ClientServices", fields: [clientNo], references: [clientNo])
  appointments Appointment[]
}

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  clientNo  Int
  date      DateTime
  time      String
  amount    Float
  status    Status   @default(PENDING)
  notes     String?
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation("UserAppointments", fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  client  User?   @relation("ClientAppointments", fields: [clientNo], references: [clientNo])
}

enum Role {
  USER
  CLIENT
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  ADMIN_LOGIN
  ADMIN_CREATED
  CLIENT_CREATED
  CLIENT_DELETED
  CLIENT_EDITED
  REPORT_GENERATED
  REPORT_DOWNLOADED
}

model Activity {
  id          String      @id @default(cuid())
  type        ActivityType
  description String
  userId      String?     // admin who performed the action
  targetId    String?     // id of the target (new admin, new client, etc.)
  metadata    Json?       // additional data
  createdAt   DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id])
}

model FileUpload {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  mimeType    String?
  sizeInBytes BigInt    @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
